# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# ── Environment / Secrets (NEVER commit these) ────
.env
.env.*
!.env.example

# ── Database ──────────────────────────────────────
*.db
*.sqlite3

# ── FAISS / ML indexes (rebuilt at runtime) ───────
backend/data/faiss_index/
backend/data/*.npy
backend/data/*.index

# ── Node / Frontend ───────────────────────────────
frontend/node_modules/
frontend/dist/
node_modules/

# ── OS / Editor ───────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
